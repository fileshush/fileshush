---
import { site } from "../config";
import { tools } from "../lib/tools";
import Icon from "./Icon.astro";
import OwlMark from "./OwlMark.astro";
import ToolIcon from "./ToolIcon.astro";
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <OwlMark size={30} />
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      <div class="nav-menu">
        <button
          class="nav-link nav-menu__trigger"
          type="button"
          aria-expanded="false"
          aria-controls="tools-menu"
          data-menu-trigger
        >
          Tools
          <Icon name="chevron-down" size={16} />
        </button>
        <div class="nav-menu__panel" id="tools-menu" hidden data-menu-panel>
          <ul>
            {tools.map((tool) => (
              <li>
                <a href={tool.url}>
                  <span class="nav-menu__icon"><ToolIcon icon={tool.icon} /></span>
                  <span class="nav-menu__text">
                    <span class="nav-menu__name">{tool.name}</span>
                    <span class="nav-menu__desc">{tool.short}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <a class="nav-link" href="/#how-it-works">How it works</a>
      <a class="nav-link" href="/about">About</a>
    </nav>

    <div class="header-actions">
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        aria-label="Switch to dark mode"
        title="Switch theme"
      >
        <Icon name="moon" size={20} class="theme-toggle__moon" />
        <Icon name="sun" size={20} class="theme-toggle__sun" />
      </button>
      <button
        class="icon-btn menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-sheet"
        aria-label="Open menu"
        title="Menu"
        data-sheet-trigger
      >
        <Icon name="menu" size={20} class="menu-btn__open" />
        <Icon name="x" size={20} class="menu-btn__close" />
      </button>
    </div>
  </div>

  <div class="sheet" id="mobile-sheet" hidden data-sheet>
    <div class="container">
      <p class="sheet__label">Tools</p>
      <ul class="sheet__tools">
        {tools.map((tool) => (
          <li>
            <a href={tool.url}>
              <span class="nav-menu__icon"><ToolIcon icon={tool.icon} /></span>
              <span class="nav-menu__text">
                <span class="nav-menu__name">{tool.name}</span>
                <span class="nav-menu__desc">{tool.short}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="sheet__label">Site</p>
      <ul class="sheet__links">
        <li><a href="/#how-it-works">How it works</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/how-we-protect-your-files">How we protect your files</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  // Theme toggle
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  function updateToggleLabel() {
    const isDark = root.dataset.theme === "dark";
    toggle?.setAttribute(
      "aria-label",
      isDark ? "Switch to light mode" : "Switch to dark mode",
    );
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", isDark ? "#12182B" : "#FFFBF5");
  }

  updateToggleLabel();

  toggle?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;

    try {
      localStorage.setItem("theme", next);
    } catch {
      // Storage can be blocked; the theme still changes for this visit.
    }

    updateToggleLabel();
  });

  // Border appears once the page scrolls
  function onScroll() {
    header?.classList.toggle("is-scrolled", window.scrollY > 4);
  }
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Tools dropdown
  const menuTrigger = document.querySelector<HTMLButtonElement>("[data-menu-trigger]");
  const menuPanel = document.querySelector<HTMLElement>("[data-menu-panel]");

  function setMenu(open: boolean) {
    if (!menuTrigger || !menuPanel) return;
    menuTrigger.setAttribute("aria-expanded", String(open));
    menuPanel.hidden = !open;
  }

  menuTrigger?.addEventListener("click", () => {
    setMenu(menuTrigger.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (!menuPanel?.contains(target) && !menuTrigger?.contains(target)) {
      setMenu(false);
    }
  });

  // Mobile sheet
  const sheetTrigger = document.querySelector<HTMLButtonElement>("[data-sheet-trigger]");
  const sheet = document.querySelector<HTMLElement>("[data-sheet]");

  function setSheet(open: boolean) {
    if (!sheetTrigger || !sheet) return;
    sheetTrigger.setAttribute("aria-expanded", String(open));
    sheetTrigger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    sheet.hidden = !open;
    root.classList.toggle("sheet-open", open);
  }

  sheetTrigger?.addEventListener("click", () => {
    setSheet(sheetTrigger.getAttribute("aria-expanded") !== "true");
  });

  sheet?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setSheet(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (menuTrigger?.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      menuTrigger.focus();
    }
    if (sheetTrigger?.getAttribute("aria-expanded") === "true") {
      setSheet(false);
      sheetTrigger.focus();
    }
  });

  // Leaving mobile width closes the sheet
  window.matchMedia("(min-width: 860px)").addEventListener("change", (event) => {
    if (event.matches) setSheet(false);
  });
</script>
