---
import { site } from "../config";
import { tools } from "../lib/tools";
import OwlMark from "./OwlMark.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <OwlMark size={30} />
          <span class="brand__name">{site.name}</span>
        </a>
        <p class="footer-tagline">{site.tagline}</p>
      </div>

      <nav class="footer-nav" aria-label="Tools">
        <h2>Tools</h2>
        <ul>
          {tools.map((tool) => <li><a href={tool.url}>{tool.name}</a></li>)}
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Company">
        <h2>Company</h2>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/how-we-protect-your-files">How we protect your files</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Legal">
        <h2>Legal</h2>
        <ul>
          <li><a href="/privacy-policy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
          {site.githubUrl && (
            <li><a href={site.githubUrl}>View the code</a></li>
          )}
        </ul>
      </nav>
    </div>

    <p class="footer-bottom">
      © {year} {site.name} · {site.version} · Made with care in Sri Lanka
    </p>
  </div>
</footer>
